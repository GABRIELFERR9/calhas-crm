# Copie para .env e ajuste. NUNCA aponte para o banco de outro sistema:
# o boot roda migrações e cria tabelas no banco indicado aqui.
PORT=3001
DB_USER=usuario
DB_HOST=127.0.0.1
DB_NAME=gestao_calhas
DB_PASSWORD=senha
DB_PORT=5432

# Login do dono. Sem ADMIN_PASSWORD, o sistema gera uma senha e imprime
# UMA vez no log na primeira subida (pm2 logs gestao-calhas).
ADMIN_USER=dono
ADMIN_PASSWORD=

# Token que a Evolution API precisa mandar no header `apikey` ao chamar
# POST /api/webhook. Sem isso o webhook recusa tudo.
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_TOKEN=

# true quando estiver atrás de HTTPS (nginx na VPS).
COOKIE_SECURE=false
